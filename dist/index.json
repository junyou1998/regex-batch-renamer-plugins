              "label": "簡體 → 通用繁體"
            },
            {
              "value": "tw2sp",
              "label": "台灣正體 → 簡體 (含常用詞彙轉換)"
            },
            {
              "value": "tw2s",
              "label": "台灣正體 → 簡體 (字形轉換)"
            },
            {
              "value": "hk2s",
              "label": "香港繁體 → 簡體"
            },
            {
              "value": "t2s",
              "label": "通用繁體 → 簡體"
            },
            {
              "value": "t2jp",
              "label": "繁體 → 日文新字體"
            },
            {
              "value": "jp2t",
              "label": "日文新字體 → 繁體"
            }
